# Copy to .env and fill in. Never commit .env.
DOMAIN=api.example.com

# --- required ---
JWT_SECRET=                      # 48+ random characters: openssl rand -hex 32
PUBLIC_BASE_URL=https://api.example.com

# --- money (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # set the same value in Razorpay > Webhooks, URL: https://DOMAIN/v5/payments/webhooks/razorpay, event: payment_link.paid
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=

# --- sign-in codes and messages (set the channels you have) ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=           # DLT-registered OTP template
MSG91_FLOW_TEMPLATE_ID=          # DLT-registered template with one variable (var1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=           # approved authentication template
WHATSAPP_TEXT_TEMPLATE=          # approved template with one body variable {{1}}
RESEND_API_KEY=
EMAIL_FROM=Gymmie <no-reply@example.com>

# --- exercise pictures and animations ---
# Where the openGym web container serves /exercise-media (HTTPS in production), and whether to show them. The pictures are
# licensed by gymvisual.com for use inside openGym only: set EXERCISE_MEDIA_LICENSED=1 only if you hold a licence for them.
OPENGYM_PUBLIC_URL=
OPENGYM_API_URL=
OPENGYM_SSO_SECRET=
EXERCISE_MEDIA_LICENSED=

# --- "talk to the creator" screen shown once to new owners and managers (leave empty to show no contact; nothing is invented) ---
COMPANY_WHATSAPP_NUMBER=
SUPPORT_EMAIL=
SUPPORT_NAME=

# --- optional ---
SUBSCRIPTION_GRACE_DAYS=7
PRICING_FILE=
COMPANY_WHATSAPP_NUMBER=
HELP_CENTER_URL=
CORS_ORIGIN=
