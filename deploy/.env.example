# Copy to .env and fill in. Never commit .env.
DOMAIN=api.example.com

# --- required ---
JWT_SECRET=                      # 48+ random characters: openssl rand -hex 32
PUBLIC_BASE_URL=https://api.example.com

# --- money (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # set the same value in Razorpay > Webhooks, URL: https://DOMAIN/v5/payments/webhooks/razorpay, event: payment_link.paid
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=

# --- sign-in codes and messages (set the channels you have) ---
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=           # DLT-registered OTP template
MSG91_FLOW_TEMPLATE_ID=          # DLT-registered template with one variable (var1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=           # approved authentication template
WHATSAPP_TEXT_TEMPLATE=          # approved template with one body variable {{1}}
RESEND_API_KEY=
EMAIL_FROM=Gymmie <no-reply@example.com>

# --- exercise pictures and animations ---
# Where the openGym web container serves /exercise-media (HTTPS in production), and whether to show them. The pictures are
# licensed by gymvisual.com for use inside openGym only: set EXERCISE_MEDIA_LICENSED=1 only if you hold a licence for them.
OPENGYM_PUBLIC_URL=
OPENGYM_API_URL=
OPENGYM_SSO_SECRET=
EXERCISE_MEDIA_LICENSED=

# --- "talk to the creator" screen shown once to new owners and managers (leave empty to show no contact; nothing is invented) ---
COMPANY_WHATSAPP_NUMBER=
SUPPORT_EMAIL=
SUPPORT_NAME=

# --- optional ---
SUBSCRIPTION_GRACE_DAYS=7
PRICING_FILE=
COMPANY_WHATSAPP_NUMBER=
HELP_CENTER_URL=
CORS_ORIGIN=

# --- operations (offsite-backup.sh, healthcheck.sh) ---
RCLONE_REMOTE=                   # for example gymmie:gymmie-backups (an rclone remote you configured)
ALERT_WEBHOOK_URL=               # Slack/Discord/ntfy URL for healthcheck.sh alerts
DISK_ALERT_PERCENT=85

# --- abuse and cost controls (see docs/DEPLOY.md) ---
ALERT_WEBHOOK_URL=               # also used by the backend: payment mismatches, lockouts, SMS budget at 80%, stuck messages
SMS_GLOBAL_PER_HOUR=400          # hard ceiling on codes the whole service may send; set to what you can afford
SMS_GLOBAL_PER_DAY=4000
SMS_PHONE_PER_HOUR=5
SMS_PHONE_PER_DAY=10
SMS_IP_PER_HOUR=20
SMS_ACCOUNT_PER_DAY=12
SMS_GYM_PORTAL_PER_DAY=150
TURNSTILE_SECRET=                # Cloudflare Turnstile secret: when set, the portal OTP and registration calls require a challengeToken
MAX_GYMS_PER_OWNER=10
FILE_QUOTA_MB=500                # per gym

# --- keys that outlive a JWT_SECRET change: generate once (openssl rand -hex 32), back up, never change ---
SEAL_KEY=
ACCESS_CODE_KEY=

# --- encrypted off-site backups: only the PUBLIC key goes on the server (deploy/keys/backup-public.pem) ---
