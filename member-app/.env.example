# --- member-app/ (openGym in single-sign-on mode) ---------------------------------------------------------
# Public HTTPS origin the app opens (this exact value; no trailing slash). Gymmie needs it as OPENGYM_PUBLIC_URL.
MEMBER_APP_ORIGIN=https://log.example.com
# Hostname only (for the unused passkey code path). Leave as the hostname of MEMBER_APP_ORIGIN.
MEMBER_APP_RP_ID=log.example.com
MEMBER_APP_PORT=8080

# Shared with the Gymmie backend. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENGYM_SSO_SECRET=

# --- Gymmie backend (backend/, NODE_ENV=production) ---------------------------------------------------------
# OPENGYM_PUBLIC_URL=https://log.example.com            # what the app opens (https in production)
# OPENGYM_API_URL=http://opengym-api.internal:3000      # how the Gymmie backend reaches openGym's API (private network)
# OPENGYM_SSO_SECRET=<same value as above>
